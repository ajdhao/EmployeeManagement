@model IEnumerable<EmployeeManagement.Models.Employee>
@{
    ViewBag.Title = "Index";
}

<h2>List of employee....</h2>
            <button class="btn btn-outline-info" >
                @Html.ActionLink("Create","Create")
            </button>
           <table class="table table-striped table-hover" >
               <thead>
                   <tr>
                       <th>@Html.DisplayNameFor(model=>model.Id)</th>
                       <th>@Html.DisplayNameFor(model=>model.Name)</th>
                       <th>@Html.DisplayNameFor(model=>model.Email)</th>
                       <th>@Html.DisplayNameFor(model=>model.Password)</th>
                       <th>Action</th>
                   </tr>
               </thead>
               @foreach (var item in Model)
               {
                   <tbody>
                       <tr>
                           <td>@Html.DisplayFor(modelitem=>item.Id)</td>
                           <td>@Html.DisplayFor(modelitem=>item.Name)</td>
                           <td>@Html.DisplayFor(modelitem=>item.Email)</td>
                           <td>@Html.DisplayFor(modelitem=>item.Password)</td>
                           <td>
                               <button class="btn btn-outline-warning">@Html.ActionLink("Edit","Edit",new { Id = item.Id})</button>|
                               <button class="btn btn-outline-info">@Html.ActionLink("Details","Details",new { Id = item.Id})</button>|
                               <button class="btn btn-outline-danger">@Html.ActionLink("Delete","Delete",new { Id = item.Id})</button>
                           </td>
                       </tr>
                   </tbody>
               }
           </table>

